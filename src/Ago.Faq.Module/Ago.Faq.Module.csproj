<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ago.Platform.Hosting carries IProductModule - the platform/product seam a host composes against.
    Ago.Platform.Resilience is referenced here, not in Ago.Faq.Infrastructure.OpenAiCompatible: the
    identical "protecting a boundary is composition-root work, not the adapter's own concern" placement
    rule ago-chat's own ReplyDraftResiliencePipeline/ResilientReplyDraftGenerator follow.
  -->
  <ItemGroup Condition="'$(AgoFaqDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Hosting" />
    <PackageReference Include="Ago.Platform.Resilience" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoFaqDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Hosting\Ago.Platform.Hosting.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Resilience\Ago.Platform.Resilience.csproj" />
  </ItemGroup>

  <!-- No direct Microsoft.Extensions.Http/Logging.Abstractions reference - both arrive transitively
       through the Ago.Faq.Infrastructure.OpenAiCompatible project reference below, the identical shape
       ago-chat's own Ago.Chat.Module.csproj relies on (Microsoft.Extensions.Http lives on
       Ago.Chat.Infrastructure.YandexGpt's own .csproj, not on ChatModule's, even though ChatModule.cs
       is the file that calls AddHttpClient<T>). -->

  <ItemGroup>
    <ProjectReference Include="..\Ago.Faq.Application\Ago.Faq.Application.csproj" />
    <ProjectReference Include="..\Ago.Faq.Infrastructure.Postgres\Ago.Faq.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\Ago.Faq.Infrastructure.OpenAiCompatible\Ago.Faq.Infrastructure.OpenAiCompatible.csproj" />
  </ItemGroup>

</Project>
