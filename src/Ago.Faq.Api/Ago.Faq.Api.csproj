<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Host: connections, commands, queries (adr/0013's split by failure profile, applied to a product
    with exactly one host - see Ago.Faq.Module's own remarks). Ago.Platform.Hosting arrives
    transitively through Ago.Faq.Module - a host composes the module, it does not duplicate its
    package list.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Ago.Faq.Module\Ago.Faq.Module.csproj" />
    <ProjectReference Include="..\Ago.Faq.Contracts\Ago.Faq.Contracts.csproj" />
  </ItemGroup>

  <!-- The knowledge-base console endpoint's JWT bearer validation. Not in the shared framework, so it
       is named here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
